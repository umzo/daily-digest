{
  "name": "daily-digest",
  "version": "0.1.0",
  "description": "Feedly から記事を収集・要約し、Obsidian Vault に公開するサーバーレスシステム",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "devDependencies": {
    "@types/node": "20.19.27",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
