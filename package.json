{
  "name": "daily-digest",
  "version": "0.1.0",
  "description": "Feedly から記事を収集・要約し、Obsidian Vault に公開するサーバーレスシステム",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "24.10.4",
    "tsdown": "0.18.4",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@aws-sdk/client-secrets-manager": "^3.958.0"
  }
}
