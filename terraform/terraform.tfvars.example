# ============================================================================
# Daily Digest - Terraform Variables Example
# ============================================================================
# このファイルをコピーして terraform.tfvars を作成し、値を設定してください:
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars は .gitignore に追加し、コミットしないでください。
# ============================================================================

# AWS Configuration
aws_region  = "ap-northeast-1"
environment = "prod"

# Lambda Configuration
lambda_function_name = "daily-digest"
lambda_timeout       = 900  # 15 minutes
lambda_memory_size   = 256
lambda_runtime       = "nodejs24.x"
lambda_handler       = "index.handler"

# GitHub Configuration (必須)
github_owner  = "your-github-username"
github_repo   = "your-obsidian-vault-repo"
github_branch = "main"

# Schedule Configuration
schedule_expression = "cron(0 21 * * ? *)"  # 6:00 JST (21:00 UTC)
schedule_enabled    = true

# Secrets Configuration
secrets_name = "daily-digest-secrets"

# CloudWatch Logs Configuration
log_retention_days = 14
